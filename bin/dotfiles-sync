#!/usr/bin/env bash
# dotfiles-sync: Automated, non-destructive background sync for dotfiles & agent configs.
# Safely pulls latest master/main, updates submodules, and syncs agent permissions.

set -euo pipefail

# Ensure standard tool paths are accessible in launchd / cron / subshells
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Resolve symlinks to locate the real dotfiles repository root
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
DOTFILES_DIR="$(cd -P "$SCRIPT_DIR/.." && pwd)"
LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/sync.log"

VERBOSE=false
DRY_RUN=false

log() {
    local msg="$1"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    if [[ "$VERBOSE" == true ]]; then
        echo "[$timestamp] $msg"
    fi
    if [[ -d "$(dirname "$LOG_FILE")" ]]; then
        echo "[$timestamp] $msg" >> "$LOG_FILE"
    fi
}

show_status() {
    echo "=== Dotfiles Sync Status ==="
    echo "Repository:    $DOTFILES_DIR"
    if [[ ! -d "$DOTFILES_DIR/.git" ]]; then
        echo "Git Status:    Not a git repository"
        return 0
    fi

    local current_branch
    current_branch="$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
    local head_commit
    head_commit="$(git -C "$DOTFILES_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
    echo "Active Branch: $current_branch ($head_commit)"

    if [[ -f "$DOTFILES_DIR/.git/FETCH_HEAD" ]]; then
        local last_fetch
        if [[ "$(uname -s)" == "Darwin" ]]; then
            last_fetch="$(stat -f "%Sm" "$DOTFILES_DIR/.git/FETCH_HEAD")"
        else
            last_fetch="$(stat -c "%y" "$DOTFILES_DIR/.git/FETCH_HEAD" 2>/dev/null || echo "unknown")"
        fi
        echo "Last Fetch:    $last_fetch"
    fi

    if [[ -r "$LOG_FILE" ]]; then
        echo ""
        echo "Recent Sync Log (last 5 entries):"
        tail -n 5 "$LOG_FILE" 2>/dev/null || true
    fi
}

for arg in "$@"; do
    case "$arg" in
        -v|--verbose)
            VERBOSE=true
            ;;
        -n|--dry-run)
            DRY_RUN=true
            VERBOSE=true
            ;;
        --status)
            show_status
            exit 0
            ;;
        -h|--help)
            echo "Usage: $(basename "$0") [--verbose|-v] [--dry-run|-n] [--status]"
            echo "  --verbose, -v   Print progress to stdout"
            echo "  --dry-run, -n   Preview actions without touching branches or files"
            echo "  --status        Show current sync status and recent log"
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            exit 1
            ;;
    esac
done

# Ensure log directory exists or fallback to /tmp
if ! mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null; then
    LOG_FILE="/tmp/dotfiles-sync.log"
fi

# Truncate log file if > 500 lines to prevent runaway growth
if [[ -f "$LOG_FILE" && "$(wc -l < "$LOG_FILE")" -gt 500 ]]; then
    tail -n 200 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv "${LOG_FILE}.tmp" "$LOG_FILE"
fi

if [[ ! -d "$DOTFILES_DIR/.git" ]]; then
    log "[skip] Not a git repository: $DOTFILES_DIR"
    exit 0
fi

# Skip if git index is currently locked by another process
if [[ -f "$DOTFILES_DIR/.git/index.lock" ]]; then
    log "[skip] Git index lock active, skipping sync cycle"
    exit 0
fi

# Fetch latest refs from origin quietly. If offline or unreachable, exit cleanly.
if ! git -C "$DOTFILES_DIR" fetch origin --quiet 2>/dev/null; then
    log "[offline] Could not reach remote origin, skipping"
    exit 0
fi

# Detect default remote tracking branch (master vs main)
DEFAULT_BRANCH="master"
if git -C "$DOTFILES_DIR" rev-parse --verify origin/main >/dev/null 2>&1; then
    DEFAULT_BRANCH="main"
fi

CURRENT_BRANCH="$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD")"
IS_DIRTY="$(git -C "$DOTFILES_DIR" status --porcelain 2>/dev/null || true)"
SYNCED=false

if [[ "$CURRENT_BRANCH" == "$DEFAULT_BRANCH" ]]; then
    if [[ -n "$IS_DIRTY" ]]; then
        log "[skip] Checked out on $DEFAULT_BRANCH with uncommitted modifications, skipping working tree merge"
    else
        BEHIND="$(git -C "$DOTFILES_DIR" rev-list "HEAD..origin/$DEFAULT_BRANCH" --count 2>/dev/null || echo 0)"
        if [[ "$BEHIND" -gt 0 ]]; then
            log "[update] Local $DEFAULT_BRANCH is $BEHIND commit(s) behind origin/$DEFAULT_BRANCH; fast-forwarding..."
            if [[ "$DRY_RUN" == false ]]; then
                git -C "$DOTFILES_DIR" merge --ff-only "origin/$DEFAULT_BRANCH" --quiet
                SYNCED=true
            else
                log "[dry-run] Would run: git merge --ff-only origin/$DEFAULT_BRANCH"
            fi
        else
            log "[ok] Local $DEFAULT_BRANCH is already up to date"
        fi
    fi
else
    # On a feature branch: non-destructively fast-forward local default branch ref without checking it out
    BEHIND="$(git -C "$DOTFILES_DIR" rev-list "$DEFAULT_BRANCH..origin/$DEFAULT_BRANCH" --count 2>/dev/null || echo 0)"
    if [[ "$BEHIND" -gt 0 ]]; then
        log "[update] Background updating local $DEFAULT_BRANCH ref ($BEHIND commits behind) while on $CURRENT_BRANCH..."
        if [[ "$DRY_RUN" == false ]]; then
            git -C "$DOTFILES_DIR" fetch origin "$DEFAULT_BRANCH:$DEFAULT_BRANCH" --quiet 2>/dev/null || true
            SYNCED=true
        else
            log "[dry-run] Would run: git fetch origin $DEFAULT_BRANCH:$DEFAULT_BRANCH"
        fi
    else
        log "[ok] Base $DEFAULT_BRANCH is up to date (active branch: $CURRENT_BRANCH)"
    fi
fi

# Run post-sync housekeeping if new commits were integrated
if [[ "$SYNCED" == true && "$DRY_RUN" == false ]]; then
    # Update submodules if defined
    if [[ -f "$DOTFILES_DIR/.gitmodules" ]]; then
        git -C "$DOTFILES_DIR" submodule update --init --recursive --quiet 2>/dev/null || true
    fi

    # Sync permissions and safety hooks to Antigravity & Claude settings
    if [[ -f "$DOTFILES_DIR/agents/hooks/sync_permissions.py" ]]; then
        python3 "$DOTFILES_DIR/agents/hooks/sync_permissions.py" >/dev/null 2>&1 || true
    fi

    # Clear gatekeeper provenance on macOS to prevent seatbelt sandbox restrictions
    if [[ "$(uname -s)" == "Darwin" ]] && command -v xattr >/dev/null 2>&1; then
        xattr -dr com.apple.provenance "$DOTFILES_DIR" 2>/dev/null || true
    fi

    NEW_REV="$(git -C "$DOTFILES_DIR" rev-parse --short "$DEFAULT_BRANCH" 2>/dev/null || echo "")"
    log "[success] Dotfiles synced to $DEFAULT_BRANCH at $NEW_REV"
fi
