#!/usr/bin/env bash
# dotfiles-sync: Automated, non-destructive background sync for dotfiles & agent configs.
# Safely pulls latest master/main, updates submodules, and syncs agent permissions.

set -euo pipefail

# Ensure standard tool paths are accessible in launchd / cron / subshells
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Prevent interactive prompts and set connect timeouts for remote operations
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10"

# Resolve symlinks to locate the real dotfiles repository root
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
DOTFILES_DIR="$(cd -P "$SCRIPT_DIR/.." && pwd)"
LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/sync.log"
LOCK_DIR="/tmp/dotfiles-sync.lock"

VERBOSE=false
DRY_RUN=false

log() {
    local msg="$1"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    if [[ "$VERBOSE" == true ]]; then
        echo "[$timestamp] $msg"
    fi
    echo "[$timestamp] $msg" >> "$LOG_FILE" 2>/dev/null || true
}

acquire_lock() {
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        local lock_mtime=0
        if [[ "$(uname -s)" == "Darwin" ]]; then
            lock_mtime="$(stat -f "%m" "$LOCK_DIR" 2>/dev/null || echo 0)"
        else
            lock_mtime="$(stat -c "%Y" "$LOCK_DIR" 2>/dev/null || echo 0)"
        fi
        local now
        now="$(date +%s)"
        # Break stale locks older than 10 minutes (600 seconds)
        if (( now - lock_mtime > 600 )); then
            rm -rf "$LOCK_DIR"
            mkdir "$LOCK_DIR" 2>/dev/null || return 1
        else
            return 1
        fi
    fi
    return 0
}

sync_agent_memory() {
    local mem_dir="${HOME}/Projects/agent-memory"
    if [[ ! -d "$mem_dir/.git" ]]; then
        return 0
    fi
    if ! git -C "$mem_dir" remote get-url origin >/dev/null 2>&1; then
        return 0
    fi
    log "[memory] Syncing agent-memory repository..."
    if [[ "$DRY_RUN" == false ]]; then
        git -C "$mem_dir" pull --rebase origin main --quiet 2>/dev/null || log "[memory] pull --rebase failed or offline"
        local unpushed
        unpushed="$(git -C "$mem_dir" rev-list origin/main..main --count 2>/dev/null || echo 0)"
        if [[ "$unpushed" -gt 0 ]]; then
            git -C "$mem_dir" push origin main --quiet 2>/dev/null || log "[memory] push failed or offline"
        fi
    else
        log "[dry-run] Would sync agent-memory (pull --rebase & push)"
    fi
}

show_status() {
    echo "=== Dotfiles Sync Status ==="
    echo "Repository:    $DOTFILES_DIR"
    if [[ ! -d "$DOTFILES_DIR/.git" ]]; then
        echo "Git Status:    Not a git repository"
        return 0
    fi

    local current_branch
    current_branch="$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
    local head_commit
    head_commit="$(git -C "$DOTFILES_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
    echo "Active Branch: $current_branch ($head_commit)"

    if [[ -f "$DOTFILES_DIR/.git/FETCH_HEAD" ]]; then
        local last_fetch
        if [[ "$(uname -s)" == "Darwin" ]]; then
            last_fetch="$(stat -f "%Sm" "$DOTFILES_DIR/.git/FETCH_HEAD")"
        else
            last_fetch="$(stat -c "%y" "$DOTFILES_DIR/.git/FETCH_HEAD" 2>/dev/null || echo "unknown")"
        fi
        echo "Last Fetch:    $last_fetch"
    fi

    if [[ -r "$LOG_FILE" ]]; then
        echo ""
        echo "Recent Sync Log (last 5 entries):"
        tail -n 5 "$LOG_FILE" 2>/dev/null || true
    fi
}

for arg in "$@"; do
    case "$arg" in
        -v|--verbose)
            VERBOSE=true
            ;;
        -n|--dry-run)
            DRY_RUN=true
            VERBOSE=true
            ;;
        --status)
            show_status
            exit 0
            ;;
        -h|--help)
            echo "Usage: $(basename "$0") [--verbose|-v] [--dry-run|-n] [--status]"
            echo "  --verbose, -v   Print progress to stdout"
            echo "  --dry-run, -n   Preview actions without touching branches or files"
            echo "  --status        Show current sync status and recent log"
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            exit 1
            ;;
    esac
done

# Ensure log directory and file are writable, or fallback to /tmp
if ! (mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null && touch "$LOG_FILE" 2>/dev/null); then
    LOG_FILE="/tmp/dotfiles-sync.log"
    touch "$LOG_FILE" 2>/dev/null || true
fi

# Truncate log file if > 500 lines to prevent runaway growth
if [[ -f "$LOG_FILE" && -r "$LOG_FILE" ]]; then
    LOG_LINES="$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)"
    if [[ "$LOG_LINES" -gt 500 ]]; then
        (tail -n 200 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv "${LOG_FILE}.tmp" "$LOG_FILE") 2>/dev/null || true
    fi
fi

if [[ ! -d "$DOTFILES_DIR/.git" ]]; then
    log "[skip] Not a git repository: $DOTFILES_DIR"
    exit 0
fi

# Concurrency guard: avoid racing simultaneous fish startup / launchd instances
if ! acquire_lock; then
    log "[skip] Another sync instance is currently active, skipping"
    exit 0
fi
trap 'rm -rf "$LOCK_DIR"' EXIT

# Skip if git index is currently locked by active git editing/commit
if [[ -f "$DOTFILES_DIR/.git/index.lock" ]]; then
    log "[skip] Git index lock active, skipping sync cycle"
    exit 0
fi

# Low-speed and connection timeouts to prevent hanging on captive portals
GIT_FETCH_CMD=(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 -C "$DOTFILES_DIR")

# Fetch latest refs from origin quietly. If offline or unreachable, exit cleanly.
if ! "${GIT_FETCH_CMD[@]}" fetch origin --quiet 2>/dev/null; then
    log "[offline] Could not reach remote origin, skipping"
    exit 0
fi

# Detect default remote tracking branch (master vs main)
DEFAULT_BRANCH="master"
if git -C "$DOTFILES_DIR" rev-parse --verify origin/main >/dev/null 2>&1; then
    DEFAULT_BRANCH="main"
fi

CURRENT_BRANCH="$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD")"
# Check only tracked file modifications; untracked scratch files do not block fast-forward
IS_DIRTY="$(git -C "$DOTFILES_DIR" status --porcelain --untracked-files=no 2>/dev/null || true)"
SYNCED=false

if [[ "$CURRENT_BRANCH" == "$DEFAULT_BRANCH" ]]; then
    if [[ -n "$IS_DIRTY" ]]; then
        log "[skip] Checked out on $DEFAULT_BRANCH with uncommitted modifications, skipping working tree merge"
    else
        BEHIND="$(git -C "$DOTFILES_DIR" rev-list "HEAD..origin/$DEFAULT_BRANCH" --count 2>/dev/null || echo 0)"
        if [[ "$BEHIND" -gt 0 ]]; then
            log "[update] Local $DEFAULT_BRANCH is $BEHIND commit(s) behind origin/$DEFAULT_BRANCH; fast-forwarding..."
            if [[ "$DRY_RUN" == false ]]; then
                if "${GIT_FETCH_CMD[@]}" merge --ff-only "origin/$DEFAULT_BRANCH" --quiet 2>/dev/null; then
                    SYNCED=true
                else
                    log "[warn] Fast-forward merge of origin/$DEFAULT_BRANCH failed; manual intervention required"
                fi
            else
                log "[dry-run] Would run: git merge --ff-only origin/$DEFAULT_BRANCH"
            fi
        else
            log "[ok] Local $DEFAULT_BRANCH is already up to date"
        fi
    fi
else
    # On a feature branch: non-destructively fast-forward local default branch ref without touching working tree
    BEHIND="$(git -C "$DOTFILES_DIR" rev-list "$DEFAULT_BRANCH..origin/$DEFAULT_BRANCH" --count 2>/dev/null || echo 0)"
    if [[ "$BEHIND" -gt 0 ]]; then
        log "[update] Background updating local $DEFAULT_BRANCH ref ($BEHIND commits behind) while on $CURRENT_BRANCH..."
        if [[ "$DRY_RUN" == false ]]; then
            if "${GIT_FETCH_CMD[@]}" fetch origin "$DEFAULT_BRANCH:$DEFAULT_BRANCH" --quiet 2>/dev/null; then
                NEW_REV="$(git -C "$DOTFILES_DIR" rev-parse --short "$DEFAULT_BRANCH" 2>/dev/null || echo "")"
                log "[success] Background updated local $DEFAULT_BRANCH to $NEW_REV while on $CURRENT_BRANCH"
            else
                log "[warn] Background update of $DEFAULT_BRANCH ref failed (diverged); manual sync required"
            fi
        else
            log "[dry-run] Would run: git fetch origin $DEFAULT_BRANCH:$DEFAULT_BRANCH"
        fi
    else
        log "[ok] Base $DEFAULT_BRANCH is up to date (active branch: $CURRENT_BRANCH)"
    fi
fi

# Run post-sync housekeeping ONLY when master working tree was updated
if [[ "$SYNCED" == true && "$DRY_RUN" == false ]]; then
    # Update submodules if defined
    if [[ -f "$DOTFILES_DIR/.gitmodules" ]]; then
        git -C "$DOTFILES_DIR" submodule update --init --recursive --quiet 2>/dev/null || true
    fi

    # Sync permissions and safety hooks to Antigravity & Claude settings
    if [[ -f "$DOTFILES_DIR/agents/hooks/sync_permissions.py" ]]; then
        python3 "$DOTFILES_DIR/agents/hooks/sync_permissions.py" >/dev/null 2>&1 || true
    fi

    # Clear gatekeeper provenance on macOS to prevent seatbelt sandbox restrictions
    if [[ "$(uname -s)" == "Darwin" ]] && command -v xattr >/dev/null 2>&1; then
        xattr -dr com.apple.provenance "$DOTFILES_DIR" 2>/dev/null || true
    fi

    NEW_REV="$(git -C "$DOTFILES_DIR" rev-parse --short "$DEFAULT_BRANCH" 2>/dev/null || echo "")"
    log "[success] Dotfiles synced to $DEFAULT_BRANCH at $NEW_REV"
fi

# Synchronize agent-memory repository if configured
sync_agent_memory
