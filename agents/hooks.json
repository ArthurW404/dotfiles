{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/Projects/dotfiles/agents/hooks/safety_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "sound-alerts": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/Projects/dotfiles/agents/hooks/notifier.py --event stop",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/Projects/dotfiles/agents/hooks/notifier.py --event prompt",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "session-breadcrumbs": {
    "PostToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/Projects/dotfiles/agents/hooks/breadcrumb.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
