# Repository gitignore for ~/Projects/dotfiles

# Local git identity overrides (contains private email/keys)
.gitconfig.local

# Neovim plugin manager lockfile (optional, kept machine-independent)
.config/nvim/lazy-lock.json

# macOS metadata
.DS_Store
.DS_Store?
._*

# Editor swap files
*.swp
*.swo
*~

# Databases, local data stores & caches
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.duckdb
