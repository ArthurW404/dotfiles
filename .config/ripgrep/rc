# ~/.config/ripgrep/rc
# Default ripgrep runtime arguments (RIPGREP_CONFIG_PATH)
# Note: Avoid `--sort=path` here as sorting forces single-threaded execution.

# Search case-insensitively if pattern is all lowercase, case-sensitively otherwise
--smart-case

# Include hidden files and directories in search
--hidden

# Exclude .git directory from results
--glob=!.git/*
